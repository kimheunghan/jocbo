<?xml version="1.0" encoding="utf-8"?>
<!-- 우리의 족보 - Microsoft Store 용 MSIX 패키지 설명서.
     {{…}} 자리는 desktop/make_msix.py 가 identity.json 과 판 번호로 채웁니다. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap10 rescap">

  <Identity Name="{{NAME}}" Publisher="{{PUBLISHER}}" Version="{{VERSION}}" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>우리의 족보</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="ko-KR" />
  </Resources>

  <Applications>
    <!-- 실행기는 파이썬 모듈로 띄웁니다. 임베디드 파이썬의 ._pth 가 프로그램 폴더를 가리키므로
         현재 폴더와 상관없이 launcher 를 찾습니다. -->
    <Application Id="Jocbo" Executable="python\pythonw.exe" EntryPoint="Windows.FullTrustApplication"
                 uap10:Parameters="-m launcher">
      <uap:VisualElements DisplayName="우리의 족보" Description="족보 정리와 가계도 프로그램"
                          BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square71x71Logo="Assets\Square71x71Logo.png"
                         Square310x310Logo="Assets\Square310x310Logo.png" />
      </uap:VisualElements>
      <!-- 바탕화면 바로가기는 Windows 가 만들지 않습니다(2026.11.12). Windows 가 만든 바로가기는
           잠긴 설치 폴더(WindowsApps\…\pythonw.exe)를 직접 가리켜, 회사 PC 등에서 "액세스할 수
           없습니다" 오류가 났고 업데이트마다 다시 그렇게 써졌습니다. 대신 앱이 처음 켜질 때
           시작 메뉴와 같은 방식(explorer.exe shell:AppsFolder\…!Jocbo)의 바로가기를 만듭니다
           (desktop/launcher.py fix_shortcut). Store 에서 설치하면 [열기]로 한 번 켜지므로 그때 생깁니다. -->
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
